+#define PERSONALIZATION_SP_GK_AUTH "sp-gk-authentication"
+
+static bool Add_Hardware_Auth_Token(const HardwareAuthToken& authToken) {
+	AIBinder* authzAIBinder = AServiceManager_waitForService("android.security.authorization");
+	if (authzAIBinder == nullptr) {
+		printf("Keystore authorization service is unavailable\n");
+		return false;
+	}
+	::ndk::SpAIBinder binder(authzAIBinder);
+	auto service = aidl::android::security::authorization::IKeystoreAuthorization::fromBinder(binder);
+	if (service == nullptr) {
+		printf("Unable to connect to keystore authorization service\n");
+		return false;
+	}
+	auto result = service->addAuthToken(authToken);
+	if (!result.isOk()) {
+		printf("Unable to add auth token to keystore: %s\n", result.getDescription().c_str());
+		return false;
+	}
+	return true;
+}
+
+// AOSP SyntheticPassword.deriveGkPassword(): v3 uses SP800-108 HMAC-SHA256,
+// v1/v2 use the legacy SHA-512 personalized hash.  The result must be raw bytes,
+// not the hex form that TWRP uses for the FBE key.
+static std::string Derive_SP_GK_Password(const std::string& sp, int version) {
+	if (version >= 3) {
+		std::string hex = PersonalizedHashSP800(PERSONALIZATION_SP_GK_AUTH,
+			PERSONALISATION_CONTEXT, sp.data(), sp.size());
+		if (hex.size() != 64) return "";
+		std::string raw;
+		raw.resize(32);
+		for (size_t i = 0; i < 32; ++i) {
+			auto nibble = [](char c) -> int {
+				if (c >= '0' && c <= '9') return c - '0';
+				if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+				if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+				return -1;
+			};
+			int hi = nibble(hex[i * 2]);
+			int lo = nibble(hex[i * 2 + 1]);
+			if (hi < 0 || lo < 0) return "";
+			raw[i] = static_cast<char>((hi << 4) | lo);
+		}
+		return raw;
+	}
+	void* digest = PersonalizedHashBinary(PERSONALIZATION_SP_GK_AUTH, sp.data(), sp.size());
+	if (digest == nullptr) return "";
+	std::string raw(reinterpret_cast<const char*>(digest), SHA512_DIGEST_LENGTH);
+	free(digest);
+	return raw;
+}
+
+// Equivalent to SyntheticPasswordManager.verifyChallenge(): verify the SP-derived
+// Gatekeeper password against the user's SP handle, then hand the resulting
+// HardwareAuthToken to Keystore.  Without this, a Weaver unlock never authorizes
+// the parent-SID-bound profile_key_name_decrypt_* keys.
+static bool Add_SP_Gatekeeper_AuthToken(const userid_t user_id, const std::string& sp, int version) {
+	std::string handle_path = "/data/system_de/" + std::to_string(user_id) +
+		"/spblob/0000000000000000.handle";
+	std::string sp_handle;
+	if (!android::base::ReadFileToString(handle_path, &sp_handle) || sp_handle.empty()) {
+		printf("SP Gatekeeper handle is unavailable for user %d\n", user_id);
+		return false;
+	}
+	const std::string gk_password = Derive_SP_GK_Password(sp, version);
+	if (gk_password.empty()) {
+		printf("Unable to derive SP Gatekeeper password for user %d\n", user_id);
+		return false;
+	}
+
+	::ndk::SpAIBinder binder(AServiceManager_waitForService(
+		"android.hardware.gatekeeper.IGatekeeper/default"));
+	auto gatekeeper = AidlIGatekeeper::fromBinder(binder);
+	if (gatekeeper == nullptr) {
+		printf("AIDL Gatekeeper service is unavailable\n");
+		return false;
+	}
+	android::hardware::hidl_vec<uint8_t> handle_hidl;
+	handle_hidl.setToExternal(const_cast<uint8_t*>(reinterpret_cast<const uint8_t*>(sp_handle.data())),
+		sp_handle.size());
+	android::hardware::hidl_vec<uint8_t> password_hidl;
+	password_hidl.setToExternal(const_cast<uint8_t*>(reinterpret_cast<const uint8_t*>(gk_password.data())),
+		gk_password.size());
+	AidlGatekeeperVerifyResp response;
+	// The 0000000000000000.handle blob is the SP handle enrolled by
+	// SyntheticPasswordManager.newSidForUser(), which uses the real Android
+	// user id (not the legacy fakeUid credential path).
+	auto result = gatekeeper->verify(user_id, 0 /* challenge */, handle_hidl,
+		password_hidl, &response);
+	if (!result.isOk() || response.statusCode < AidlIGatekeeper::STATUS_OK) {
+		printf("SP Gatekeeper verification failed for user %d (status %d)\n",
+			user_id, response.statusCode);
+		return false;
+	}
+	if (!Add_Hardware_Auth_Token(response.hardwareAuthToken)) {
+		printf("Unable to add SP auth token for user %d\n", user_id);
+		return false;
+	}
+	printf("SP Gatekeeper auth token added for user %d\n", user_id);
+	return true;
+}
