+static bool Get_Tied_Profile_Parent(const userid_t user_id, userid_t* parent) {
+	if (parent == nullptr) return false;
+	std::string user_xml;
+	std::string path = "/data/system/users/" + std::to_string(user_id) + ".xml";
+	if (!android::base::ReadFileToString(path, &user_xml)) {
+		printf("Unable to read profile metadata for user %d\n", user_id);
+		if (user_id >= 900 && user_id <= 999) {
+			*parent = 0;
+			printf("App clone user %d has no readable metadata; using owner 0\n",
+				user_id);
+			return true;
+		}
+		return false;
+	}
+	const std::string attr = "profileGroupId=\"";
+	size_t pos = user_xml.find(attr);
+	if (pos == std::string::npos) {
+		// HyperOS app clones are created outside the normal profile path and
+		// often omit profileGroupId from their user metadata. Their profile
+		// key is still tied to the owner, so treat clone users as children of
+		// user 0 instead of falling back to their unusable own credential.
+		if (user_id >= 900 && user_id <= 999) {
+			*parent = 0;
+			printf("App clone user %d has no profileGroupId; using owner 0\n",
+				user_id);
+			return true;
+		}
+		return false;
+	}
+	pos += attr.size();
+	char* end = nullptr;
+	const long parsed_parent = strtol(user_xml.c_str() + pos, &end, 10);
+	if (end == user_xml.c_str() + pos || parsed_parent < 0 || parsed_parent > 9999 ||
+		parsed_parent == user_id) {
+		if (user_id >= 900 && user_id <= 999) {
+			*parent = 0;
+			printf("App clone user %d has invalid profileGroupId; using owner 0\n",
+				user_id);
+			return true;
+		}
+		return false;
+	}
+	*parent = static_cast<userid_t>(parsed_parent);
+	return true;
+}
+
+struct TiedProfileRecord {
+	std::string path;
+	std::string alias;
+};
+
+static bool Get_Tied_Profile_Record(const userid_t user_id, TiedProfileRecord* record) {
+	if (record == nullptr) return false;
+	const std::string aosp = "/data/system/users/" + std::to_string(user_id) +
+		"/gatekeeper.profile.key";
+	if (access(aosp.c_str(), F_OK) != 0) {
+		return false;
+	}
+	record->path = aosp;
+	record->alias = "profile_key_name_decrypt_" + std::to_string(user_id);
+	return true;
+}
+
+static std::string Decrypt_Tied_Profile_Key(const TiedProfileRecord& record) {
+	std::string key_blob;
+	if (!android::base::ReadFileToString(record.path, &key_blob)) {
+		printf("Unable to read tied profile key '%s'\n", record.path.c_str());
+		return "";
+	}
+	// AtomicFile payload: 12-byte GCM IV followed by ciphertext and 16-byte tag.
+	if (key_blob.size() < 12 + 16) {
+		printf("Tied profile key '%s' is too short (%zu bytes)\n",
+			record.path.c_str(), key_blob.size());
+		return "";
+	}
+
+	ks2::KeyDescriptor descriptor = {
+		.domain = ks2::Domain::SELINUX,
+		.nspace = NAMESPACE_LOCKSETTINGS,
+		.alias = record.alias,
+		.blob = {},
+	};
+
+	::ndk::SpAIBinder keystoreBinder(
+		AServiceManager_checkService("android.system.keystore2.IKeystoreService/default"));
+	if (keystoreBinder.get() == nullptr) {
+		printf("Keystore2 is unavailable while reading tied profile key\n");
+		return "";
+	}
+	auto keystore = ks2::IKeystoreService::fromBinder(keystoreBinder);
+	ks2::KeyEntryResponse keyEntryResponse;
+	auto rc = keystore->getKeyEntry(descriptor, &keyEntryResponse);
+	if (!rc.isOk()) {
+		printf("Unable to get tied profile key '%s': %s\n",
+			record.alias.c_str(), rc.getDescription().c_str());
+		return "";
+	}
+
+	std::variant<int, ks2::KeyEntryResponse> response = keyEntryResponse;
+	ks2::KeyEntryResponse keyResponse = std::get<ks2::KeyEntryResponse>(response);
+	if (keyResponse.iSecurityLevel == nullptr) {
+		printf("Tied profile key has no security level\n");
+		return "";
+	}
+
+	const size_t iv_size = 12;
+	const size_t cipher_size = key_blob.size() - iv_size;
+	::keystore::hidl_vec<uint8_t> iv_hidlvec;
+	iv_hidlvec.setToExternal(const_cast<uint8_t*>(reinterpret_cast<const uint8_t*>(key_blob.data())),
+		iv_size);
+	::keystore::hidl_vec<uint8_t> cipher_hidlvec;
+	cipher_hidlvec.setToExternal(
+		const_cast<uint8_t*>(reinterpret_cast<const uint8_t*>(key_blob.data())) + iv_size,
+		cipher_size);
+
+	auto begin_params = keymint::AuthorizationSetBuilder()
+		.Authorization(keymint::TAG_ALGORITHM, ::keymint::Algorithm::AES)
+		.Authorization(::keymint::TAG_BLOCK_MODE, ::keymint::BlockMode::GCM)
+		.Padding(::keymint::PaddingMode::NONE)
+		.Authorization(keymint::TAG_PURPOSE, keymint::KeyPurpose::DECRYPT)
+		.Authorization(::keymint::TAG_NONCE, iv_hidlvec)
+		.Authorization(::keymint::TAG_MAC_LENGTH, 128);
+
+	ks2::CreateOperationResponse operationResponse;
+	auto begin_rc = keyResponse.iSecurityLevel->createOperation(
+		keyResponse.metadata.key, begin_params.vector_data(), true, &operationResponse);
+	if (!begin_rc.isOk()) {
+		printf("Unable to begin tied profile key decryption: %s\n",
+			begin_rc.getDescription().c_str());
+		return "";
+	}
+	if (operationResponse.iOperation == nullptr) {
+		printf("Tied profile key decryption returned no operation\n");
+		return "";
+	}
+	std::optional<std::vector<uint8_t>> plaintext;
+	begin_rc = operationResponse.iOperation->finish(cipher_hidlvec, {}, &plaintext);
+	if (!begin_rc.isOk() || !plaintext || plaintext->empty()) {
+		printf("Unable to finish tied profile key decryption\n");
+		return "";
+	}
+
+	std::string profile_password(reinterpret_cast<const char*>(plaintext->data()), plaintext->size());
+	printf("Decrypted tied profile key '%s' (credential length %zu)\n",
+		record.alias.c_str(), profile_password.size());
+	return profile_password;
+}
+
+static int Decrypt_Tied_Profile(const userid_t user_id, const std::string& Password) {
+	TiedProfileRecord record;
+	if (!Get_Tied_Profile_Record(user_id, &record)) {
+		return 0;
+	}
+
+	userid_t parent = 0;
+	if (!Get_Tied_Profile_Parent(user_id, &parent)) {
+		printf("User %d has a profile key but no valid profile parent; using normal unlock\n",
+			user_id);
+		return 0;
+	}
+	printf("User %d has a tied profile lock (parent %d, file %s)\n",
+		user_id, parent, record.path.c_str());
+
+	if (!Decrypt_User_Synth_Pass(parent, Password, false)) {
+		printf("Unable to verify parent user %d credential for tied profile %d\n",
+			parent, user_id);
+		return -1;
+	}
+	printf("Parent user %d credential verified for tied profile %d\n", parent, user_id);
+
+	std::string profile_password = Decrypt_Tied_Profile_Key(record);
+	if (!profile_password.empty() &&
+		Decrypt_User_Synth_Pass(user_id, profile_password)) {
+		printf("Tied profile user %d unlocked with its profile credential\n", user_id);
+		return 1;
+	}
+
+	printf("Unable to unlock tied profile user %d\n", user_id);
+	return -1;
+}
