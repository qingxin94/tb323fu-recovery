AERA_MAINTAINER := TB323FU port
# Native panel is 3040 x 1904. AERA takes both axes in the stock theme's
# 1080-wide units and multiplies them by 4/3, so the logical canvas must be
# 1904 x 3040 (portrait) / 3040 x 1904 (landscape). Setting only the height
# leaves the default 1440 width and stretches every circle and card horizontally.
AERA_SCREEN_W := 1428
AERA_SCREEN_H := 2280
AERA_STATUS_H := 114
AERA_HIDE_NOTCH := 0
AERA_STATUS_INDENT_LEFT := 50
AERA_STATUS_INDENT_RIGHT := 30
AERA_OPTIONS_LIST_NUM := 6
AERA_USE_GREEN_LED := 0
AERA_DEFAULT_TIMEZONE := CST-8

AERA_ENABLE_ALL_PARTITION_TOOLS := 1
AERA_WORKAROUND_BACKUP_BUG := 1
AERA_USE_AIDL_BOOT_CONTROL := 0
AERA_FORCE_DATA_FORMAT_F2FS := 1
AERA_UNBIND_SDCARD_F2FS := 1
AERA_WIPE_METADATA_AFTER_DATAFORMAT := 1
AERA_DYNAMIC_FULL_SIZE := 21470642176
AERA_DISPLAY_FORMAT_FILESYSTEMS_DEBUG_INFO := 1
AERA_NO_RELOAD_AFTER_DECRYPTION := 1
AERA_NO_TREBLE_COMPATIBILITY_CHECK := 1
AERA_AB_DEVICE_WITH_RECOVERY_PARTITION := 1
AERA_ENABLE_FRP_WIPE := 1
AERA_USE_LZ4_COMPRESSION := 1
AERA_ENABLE_WLAN := 1
AERA_ENABLE_EFISP := 1
