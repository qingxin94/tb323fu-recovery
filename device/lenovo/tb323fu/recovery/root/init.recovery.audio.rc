# SPDX-License-Identifier: Apache-2.0
#
# TB323FU recovery audio services.
#
# All binaries and shared libraries come from the installed stock vendor
# partition mounted by aera-audio-bootstrap.  The kernel modules are loaded in
# place from the real vendor_dlkm by aera-real-modules.sh; this file only starts
# user-space services after aera.modules.loaded is set.

service aera-audio-pd-mapper /mnt/aera-stock/vendor/bin/pd-mapper
    class core
    disabled
    user root
    group root system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /mnt/aera-stock/vendor/lib64:/vendor/lib64:/system/lib64

service aera-audio-adsprpcd /mnt/aera-stock/vendor/bin/audioadsprpcd audiopd adsp
    class main
    disabled
    user root
    group root system audio media wakelock
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /mnt/aera-stock/vendor/lib64:/vendor/lib64:/system/lib64
    setenv DSP_LIBRARY_PATH /vendor/lib/rfsa/adsp
    setenv ADSP_LIBRARY_PATH /vendor/lib/rfsa/adsp

service aera-agm-service /system/bin/aera-audio-service /mnt/aera-stock/vendor
    class main
    disabled
    user root
    group root system audio media wakelock
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /mnt/aera-stock/vendor/lib64:/vendor/lib64:/system/lib64
    setenv ANDROID_ROOT /system
    setenv ANDROID_DATA /data

service aera-audio-bootstrap /system/bin/aera-audio-bootstrap
    class core
    disabled
    oneshot
    user root
    group root system audio media wakelock
    seclabel u:r:recovery:s0

on property:aera.modules.loaded=true
    start aera-audio-bootstrap
