on early-init
    # cfg80211 is a vendor module but depends on the GKI rfkill module, which
    # is not present in the stock vendor_boot recovery module list.
    insmod /lib/modules/rfkill.ko
    insmod /lib/modules/cfg80211.ko
    mkdir /data/vendor 0771 system system
    mkdir /data/vendor/wifi 0770 system wifi
    mkdir /data/vendor/wifi/sockets 0770 system wifi

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

service post-boot-script /system/bin/sh -c /vendor/bin/init.kernel.post_boot-sun_default_6_2.sh
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

on init
    setprop sys.usb.configfs 1
    setprop prepdecrypt.setpatch true
    write /proc/sys/net/ipv4/ping_group_range "0 2147483647"

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice} 10
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # Wait for physical UFS block devices to avoid race conditions with early multi-LUN probing
    wait /dev/block/bootdevice/by-name/persist 10
    wait /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} 10

    # PartitionManager queries BootControl while parsing recovery.fstab.
    # Starting this HAL after twrp.fstab.processed creates a circular wait and
    # leaves recovery on the first logo with no UI.
    start vendor.boot-qti

    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

    # Mount firmware immediately
    mkdir /firmware 0771 root root
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    symlink /firmware /vendor/firmware_mnt

    # Mount persist immediately for SPU & WiFi MAC
    mkdir /persist 0771 root root
    mount ext4 /dev/block/bootdevice/by-name/persist /persist
    mkdir /mnt/vendor/persist 0771 root root
    mount ext4 /persist /mnt/vendor/persist bind

    # Setup Wi-Fi sockets in tmpfs (isolated from Android /data)
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0777 root root
    chmod 0777 /tmp/recovery
    chmod 0777 /tmp/recovery/sockets

# Recovery does not run Android's normal post-fs metadata relabel pass.  Make
# sure Virtual A/B state created by update_engine_sideload inherits
# ota_metadata_file instead of unlabeled; otherwise Android can merge the COWs
# but cannot remove merge_stats after the first successful boot.
on post-fs
    mkdir /metadata/ota 0750 root system
    mkdir /metadata/ota/snapshots 0750 root system
    restorecon --recursive /metadata/ota

on property:twrp.modules.loaded=true
    wait /firmware/image/adsp.mdt 5
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/ssr 2
    write /sys/kernel/boot_adsp/ssr 1

    mkdir /persist/secnvm 0770 system system
    mkdir /persist/spudc 0770 system system
    mkdir /mnt/vendor/spunvm 0660 system system

    mkdir /persist/iar_db 0770 system system

    wait /dev/block/bootdevice/by-name/spunvm 5
    mount vfat /dev/block/bootdevice/by-name/spunvm /mnt/vendor/spunvm

    start vendor.qti.vibrator

    restorecon --recursive /vendor/bin
    restorecon --recursive /vendor/lib64
    restorecon --recursive /vendor/etc
    restorecon --recursive /persist
    restorecon --recursive /mnt/vendor/persist

    start vendor.qseecomd
    start vendor.minkdaemon
    start vendor.keymint
    start vendor.keymint-spu-qti
    start vendor.gatekeeper_default
    start vendor.spdaemon
    start vendor.sec_nvm
    start vendor.spu_weaver

    wait /sys/class/power_supply/battery 2

    setprop twrp.module.handler_done true

on property:crypto.ready=1
    restart keystore2

service vendor.gatekeeper_default /vendor/bin/hw/android.hardware.gatekeeper-rust-service-qti
    class early_hal
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper_spu /vendor/bin/hw/android.hardware.gatekeeper-service-spu-qti
    class early_hal
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

service vendor.spu_weaver /vendor/bin/hw/android.hardware.weaver-service-spu-qti
    class early_hal
    user system
    group system drmrpc
    disabled
    seclabel u:r:recovery:s0

service recovery-wifi-init /system/bin/sh /system/bin/recovery-wifi-init.sh
    user root
    group root wifi inet
    disabled
    oneshot
    seclabel u:r:recovery:s0

service qrtr-ns /vendor/bin/qrtr-ns -f 1
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service rmt_storage /vendor/bin/rmt_storage
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service cnss-daemon /vendor/bin/cnss-daemon -n -l
    user root
    group root wifi inet
    disabled
    seclabel u:r:recovery:s0

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -Dnl80211 -iwlan0 -c/vendor/etc/wifi/wpa_supplicant.conf \
    -O/tmp/recovery/sockets
    user root
    group root wifi inet
    disabled
    seclabel u:r:recovery:s0

on property:vendor.gatekeeper.is_security_level_spu=0
    stop vendor.gatekeeper_spu
    stop vendor.spu_weaver
    start vendor.gatekeeper_default

on property:vendor.gatekeeper.is_security_level_spu=1
    stop vendor.gatekeeper_default
    start vendor.gatekeeper_spu
    start vendor.spu_weaver

service prepdecrypt.vendor /system/bin/sh /system/bin/prepdecrypt.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:ro.crypto.state=encrypted && property:ro.boot.dynamic_partitions=true
    start prepdecrypt.vendor

on property:sys.powerctl=*
    write /sys/class/leds/vibrator_l/activate 0
    write /sys/class/leds/vibrator_l/state 0
    write /sys/class/leds/vibrator_l/duration 0
    write /sys/class/leds/vibrator_r/activate 0
    write /sys/class/leds/vibrator_r/state 0
    write /sys/class/leds/vibrator_r/duration 0
    stop vendor.qti.vibrator

on property:vendor.sys.listeners.registered=true
    setprop sys.boot_completed 1
