# AERA recovery init for Lenovo TB323FU (Canoe / SM8850)
#
# Split is intentional:
#   - base mount + base modules: Skyward order
#   - Wi-Fi: Skyward chain, on demand only
#   - display + decryption: V13 order
#
# Nothing from Wi-Fi/audio is loaded or started at boot.

import /system/etc/init/aera-crypto.rc
import /init.recovery.wifi.rc
import /init.recovery.audio.rc
import /system/etc/init/keystore2.rc

on early-init
    setprop vendor.gralloc.enable_snapalloc true
    setprop keymaster_ver 4.x
    setprop ro.crypto.dm_default_key.options_format.version 2
    # Real /vendor/build.prop is only readable after the vendor partition is
    # mounted, which is after property loading. Set the two TEE switches here.
    setprop vendor.gatekeeper.is_security_level_spu 1
    setprop vendor.spu.rkp_enabled true

service aera-stock-mount /system/bin/sh /system/bin/aera-stock-mount.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service aera-base-modules /system/bin/sh /system/bin/aera-load-group.sh base
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0


service aera-v13-modules /system/bin/sh /system/bin/aera-load-group.sh v13
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service aera-graphics-allocator /vendor/bin/hw/vendor.qti.hardware.display.allocator-service
    class core
    disabled
    user system
    group system graphics
    seclabel u:r:recovery:s0

service aera-metadata-mount /system/bin/sh /system/bin/aera-mount-metadata.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service aera-firmware-finder /system/bin/sh /system/bin/aera-firmware-finder.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service aera-low-brightness /system/bin/sh /system/bin/aera-low-brightness.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service vendor.boot-qti /vendor/bin/hw/android.hardware.boot-service.qti
    class early_hal
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service vendor.thermal-engine /vendor/bin/thermal-engine-v2
    class core
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service vendor.qti.vibrator /vendor/bin/hw/vendor.qti.hardware.vibrator.service
    class hal
    user system
    group system input
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    setenv RICHTAP_DEVICE_PATH "/dev/aw8697_haptic_r;/dev/aw8697_haptic_l"
    setenv ENV_RICHTAP_CONFIG_PATH "/odm/etc/aac_richtap_r.config;/odm/etc/aac_richtap_l.config"

on init
    setprop sys.usb.configfs 1
    setprop twrp.user.0.decrypt 0
    start aera-metadata-mount

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    # Skyward base mount order: wait physical partitions, start BootControl,
    # then mount the real partitions.
    wait /dev/block/platform/soc/${ro.boot.bootdevice} 10
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    wait /dev/block/bootdevice/by-name/persist 10
    wait /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} 10
    start vendor.boot-qti
    start aera-stock-mount

on property:aera.stock.mounted=true
    # Skyward base group only: spss_utils + spcom + nvt_36xxx.
    start aera-base-modules

on property:aera.base.loaded=true
    # V13 display/TEE modules, still from the real vendor_dlkm/system_dlkm.
    start aera-v13-modules

on property:aera.v13.loaded=true
    setprop twrp.modules.loaded true

on property:twrp.modules.loaded=true
    # Skyward base service (vibrator) stays; display/decrypt below is V13.
    start vendor.qti.vibrator

    # V13 display + decryption order.
    start aera-firmware-finder
    exec -- /system/bin/restorecon --recursive /vendor/bin /vendor/lib64 /vendor/etc
    start aera-graphics-allocator
    # TEE chain is one-shot; start after display so a slow/failed TEE cannot
    # delay the first UI frame.
    start aera-crypto-chain

on property:crypto.ready=1
    # keystore2 starts early, before the TEE services exist. Restart it after
    # the chain is ready, exactly as the base V13 init did.
    restart keystore2


    start vendor.boot-qti
    start vendor.thermal-engine
    start aera-low-brightness
    write /sys/class/backlight/panel0-backlight/brightness 300

    setprop twrp.module.handler_done true
    start aera-audit-mounts

service aera-crypto-chain /system/bin/sh /system/bin/aera-crypto-chain.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service aera-audit-mounts /system/bin/sh /system/bin/aera-audit-mounts.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service console /system/bin/sh
    class core
    console
    disabled
    user shell
    group shell log readproc
    seclabel u:r:shell:s0
    setenv HOSTNAME console
    shutdown critical

on init && property:ro.debuggable=1
    start console
