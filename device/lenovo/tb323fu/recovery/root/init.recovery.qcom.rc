import /init.recovery.wifi.rc
import /init.recovery.usb.rc
# 本包 system 内没有 aera-pd-mapper / aera-dspservice / aera-audioadsprpcd /
# aera-audio-service 四个音频守护进程（stock 与验证树均无），导入该 rc 只会
# 产生 4 个必然失败的 service；音频链在补齐这些二进制前不启用。
# import /init.recovery.audio.rc

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

service post-boot-script /system/bin/sh -c /system/bin/init.kernel.post_boot-sun_default_6_2.sh
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

on init
    setprop sys.usb.configfs 1
    setprop prepdecrypt.setpatch true

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

    # TB323FU: ueventd only creates six by-name links on this board
    # (misc/oemowninfo/persist/ssd/xbl_b/xbl_config_b), although every
    # partition exports PARTNAME.  Bind the GPT slots we need by number:
    #   sda7  super        sde6  modem_a     sde48 modem_b
    #   sde27 recovery_a   sde68 recovery_b  sde96 spunvm
    symlink /dev/block/sda7  /dev/block/bootdevice/by-name/super
    symlink /dev/block/sde6  /dev/block/bootdevice/by-name/modem
    symlink /dev/block/sde6  /dev/block/bootdevice/by-name/modem_a
    symlink /dev/block/sde48 /dev/block/bootdevice/by-name/modem_b
    symlink /dev/block/sde96 /dev/block/bootdevice/by-name/spunvm
    symlink /dev/block/sde27 /dev/block/bootdevice/by-name/recovery_a
    symlink /dev/block/sde68 /dev/block/bootdevice/by-name/recovery_b

    # TB323FU has no fbdev at all: /sys/class/graphics is absent, the panel is
    # exposed only through DRM (card0-DSI-1).  ueventd does not create the DRM
    # character devices on this board, so create them here before the recovery
    # service starts.  Without them minui cannot open card0 and the screen
    # stays black even though init is alive.
    start aera-drm-nodes

service aera-drm-nodes /system/bin/sh -c "mkdir -p /dev/dri; mknod /dev/dri/card0 c 226 0; mknod /dev/dri/renderD128 c 226 128; chmod 666 /dev/dri/card0 /dev/dri/renderD128"
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

on property:twrp.modules.loaded=true
    # Mount firmware
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    symlink /firmware /vendor/firmware_mnt

    wait /firmware/image/adsp.mdt
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/ssr
    write /sys/kernel/boot_adsp/ssr 1

    # AERA: SOCCP (PMIC-GLINK charger/battery transport) is attached from the
    # AERA recovery process itself (see TWFunc::RunStartupScript); doing it
    # here would need the dynamically allocated /sys/class/remoteproc index,
    # which is not stable across boots.

    # sec_nvm requires persist partition.
    mkdir /persist 0771 system system
    mount ext4 /dev/block/bootdevice/by-name/persist /persist
    mkdir /mnt/vendor/persist 0660 system system
    mount ext4 /persist /mnt/vendor/persist bind

    mkdir /persist/secnvm 0770 system system
    mkdir /persist/spudc 0770 system system
    mkdir /mnt/vendor/spunvm 0660 system system

    mkdir /persist/iar_db 0770 system system

    mount vfat /dev/block/bootdevice/by-name/spunvm /mnt/vendor/spunvm

    start vendor.qti.vibrator

    # Restore SELinux labels for vendor binaries so that init can
    # perform the correct domain transition when starting services.
    # Without this, binaries under /vendor/bin get labeled as
    # u:object_r:rootfs:s0 and init refuses to start them.
    restorecon --recursive /vendor/bin
    restorecon --recursive /vendor/lib64
    restorecon --recursive /vendor/etc

    start vendor.qseecomd
    start vendor.secretkeeper
    start vendor.keymint
    start vendor.keymint-spu-qti
    start vendor.minkdaemon
    start vendor.health-default
    start vendor.boot-qti
    start vendor.gatekeeper_default
    start vendor.gatekeeper_spu
    start vendor.spdaemon
    start vendor.sec_nvm
    start vendor.spu_weaver
    # No init-level wait for /sys/class/power_supply/battery: SOCCP is
    # attached by the AERA process after init has finished, so a wait here
    # would only delay boot. The AERA status bar polls the node every 10s.

    setprop twrp.module.handler_done true

    # umount /firmware

on property:ro.crypto.state=encrypted && property:ro.boot.dynamic_partitions=true
    start prepdecrypt.vendor

on property:sys.powerctl=*
    write /sys/class/leds/vibrator_l/activate 0
    write /sys/class/leds/vibrator_l/state 0
    write /sys/class/leds/vibrator_l/duration 0
    write /sys/class/leds/vibrator_r/activate 0
    write /sys/class/leds/vibrator_r/state 0
    write /sys/class/leds/vibrator_r/duration 0
    stop vendor.qti.vibrator

on property:vendor.sys.listeners.registered=true
    setprop sys.boot_completed 1
# 全包与 stock 内都没有 vendor.ssgtzd 的 service 定义，保留这行只会出现
# "no such service" 日志；此处停用。
#    start vendor.ssgtzd


# --- TB323FU additions kept from the previous port (imports only; the boot
# --- ordering above is the one proven to reach the UI on this device).
import /system/etc/init/qseecomd.rc
import /system/etc/init/prepdecrypt.rc
import /system/etc/init/tb323fu-crypto-fix3.rc
import /system/etc/init/hlosminkdaemon.rc
import /system/etc/init/init.spdaemon.rc
import /system/etc/init/init.vendor.qti.hardware.spu.service.rc
import /system/etc/init/vendor.qti.hardware.vibrator.service.rc

# TB323FU: 白屏排查兜底 —— 即使 AERA UI 卡住，也把 recovery 日志周期性地
# 落到 /persist，便于下次开机后取回（不依赖 adb）。
service aera-log-mirror /system/bin/sh -c "mkdir -p /persist/aera; while true; do cat /tmp/recovery.log > /persist/aera/last-recovery.log 2>/dev/null; sleep 5; done"
    user root
    group root

on fs
    start aera-log-mirror
