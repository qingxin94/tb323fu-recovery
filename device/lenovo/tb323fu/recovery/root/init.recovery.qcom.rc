# Copyright (c) 2017-2018,2020-2021 The Linux Foundation. All rights reserved.
#
# AERA recovery init for Lenovo TB323FU (Canoe / SM8850)
#
# Boot policy:
#   1. mount only the real partitions; never copy vendor files into ramdisk
#   2. load a very small base group for touch + SPU/weaver
#   3. start the crypto services and let AERA's decrypt path read
#      /data/system_de/<user>/spblob
#   4. Wi-Fi / audio / haptics / time are independent groups, started on
#      demand; nothing from those groups is loaded at boot.
#

import /vendor/etc/init/aera-crypto.rc
import /init.recovery.wifi.rc
import /init.recovery.audio.rc
# AERA installs keystore2.rc at /system/etc/init/keystore2.rc, but the base
# recovery init.rc does not import it.  This import is what defines the
# keystore2 service used by "restart keystore2" below; dropping it leaves
# keystore2 undefined and PIN decryption has no key store to talk to.
import /system/etc/init/keystore2.rc

on early-init
    # Qualcomm Mapper5/SnapAlloc path must be enabled before the allocator.
    setprop vendor.gralloc.enable_snapalloc true
    # Keep the legacy Keymaster 4.x helper and wrapped-key v2 format.
    setprop keymaster_ver 4.x
    setprop ro.crypto.dm_default_key.options_format.version 2
    # Kernel firmware lookup uses the real vendor firmware partition.
    write /sys/module/firmware_class/parameters/path /vendor/firmware

# The kernel_module_loader is deliberately not used for this tree:
# AERA_LOAD_VENDOR_MODULES is empty.  These services do all loading explicitly.
service aera-stock-mount /system/bin/sh /system/bin/aera-stock-mount.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service aera-base-modules /system/bin/sh /system/bin/aera-load-group.sh base
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service aera-clock /system/bin/sh /system/bin/aera-clock.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

# Stock Qualcomm time daemon.  It uses the real RTC/persist time state and
# keeps the network/modem time path available; it is not a boot dependency.
service vendor.time_daemon /vendor/bin/time_daemon
    class core
    user system
    group system
    capabilities SYS_TIME
    disabled
    seclabel u:r:recovery:s0

service aera-haptics-modules /system/bin/sh /system/bin/aera-load-group.sh haptics
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service aera-spblob-check /system/bin/sh /system/bin/aera-spblob-check.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service aera-graphics-allocator /vendor/bin/hw/vendor.qti.hardware.display.allocator-service
    class core
    disabled
    user system
    group system graphics
    seclabel u:r:recovery:s0

# Haptics services are only started after the haptics group is explicitly
# loaded from the real vendor_dlkm.  They are not part of the boot chain.
service vendor.qti.vibrator /vendor/bin/hw/vendor.qti.hardware.vibrator.service
    class hal
    user system
    group system input
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    setenv RICHTAP_DEVICE_PATH "/dev/aw8697_haptic_r;/dev/aw8697_haptic_l"
    setenv ENV_RICHTAP_CONFIG_PATH "/odm/etc/aac_richtap_r.config;/odm/etc/aac_richtap_l.config"

service vendor.lenovo.vibrator_dual /vendor/bin/hw/vendor.lenovo.hardware.vibrator_dual-service
    interface aidl vendor.lenovo.hardware.vibrator_dual.IVibratorDual/default
    class hal
    user system
    group system input
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64

on init
    setprop sys.usb.configfs 1
    # AERA reads this before building its user list.  Force user 0 into the
    # decrypt pass; this is the user whose protector lives in
    # /data/system_de/0/spblob on this device.
    setprop twrp.user.0.decrypt 0

on property:aera.stock.mounted=true
    # The real vendor/vendor_dlkm/system_dlkm/odm partitions are now mounted.
    # Start the small base group first: touch + SPU/weaver prerequisites.
    start aera-base-modules
    # Real /vendor is mounted; the display allocator binary stays on vendor.
    start aera-graphics-allocator
    # Same brightness fallback as V13; the panel node is from the real kernel.
    write /sys/class/backlight/panel0-backlight/brightness 300
    # /persist/time/ats_2 is now readable; set the clock from RTC + ats_2.
    start aera-clock
    # Keep the stock time daemon (network/modem time path) available.
    start vendor.time_daemon

on property:aera.base.loaded=true
    # Do not fail the UI if one crypto service is missing; start the stock
    # services in order and leave their failures in the log.
    setprop vendor.gatekeeper.is_security_level_spu 1
    stop vendor.gatekeeper_default
    start vendor.qseecomd
    start vendor.minkdaemon
    start vendor.secretkeeper
    start vendor.keymint
    start vendor.keymint-spu-qti
    start vendor.spdaemon
    start vendor.sec_nvm
    start vendor.qti.hardware.spu.service
    start vendor.gatekeeper_spu
    start vendor.spu_weaver
    start aera-spblob-check
    # Give the TEE stack time to publish its services before keystore2 opens
    # them.  This is a bounded wait; it cannot block the recovery UI forever.
    wait /dev/spcom 5
    wait /dev/spss_utils 5
    setprop crypto.ready 1
    restart keystore2

on property:sys.aera.haptics.load=1
    setprop sys.aera.haptics.load 0
    start aera-haptics-modules

on property:aera.haptics.loaded=true
    # The stock haptics nodes are created by the real modules; normalise their
    # permissions here, without copying any driver or firmware into ramdisk.
    chown system system /sys/class/qcom-haptics/primitive_duration
    chmod 0600 /sys/class/qcom-haptics/primitive_duration
    chown system system /dev/aw8697_haptic_r
    chown system system /dev/aw8697_haptic_l
    chmod 0666 /dev/aw8697_haptic_r
    chmod 0666 /dev/aw8697_haptic_l
    chmod 0666 /sys/class/leds/vibrator_r/f0_save
    chmod 0666 /sys/class/leds/vibrator_l/f0_save
    chmod 0666 /sys/class/leds/vibrator_r/activate
    chmod 0666 /sys/class/leds/vibrator_l/activate
    chmod 0666 /sys/class/leds/vibrator_r/activate_mode
    chmod 0666 /sys/class/leds/vibrator_l/activate_mode
    chmod 0666 /sys/class/leds/vibrator_r/index
    chmod 0666 /sys/class/leds/vibrator_l/index
    chmod 0666 /sys/class/leds/vibrator_r/duration
    chmod 0666 /sys/class/leds/vibrator_l/duration
    chmod 0666 /sys/class/leds/vibrator_r/gain
    chmod 0666 /sys/class/leds/vibrator_l/gain
    chmod 0666 /sys/class/leds/vibrator_r/double
    chmod 0666 /sys/class/leds/vibrator_l/double
    start vendor.qti.vibrator
    start vendor.lenovo.vibrator_dual

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    # Mount the real partitions only after bootdevice/by-name is available.
    # This also keeps the recovery UI from starting before /vendor exists.
    start aera-stock-mount
