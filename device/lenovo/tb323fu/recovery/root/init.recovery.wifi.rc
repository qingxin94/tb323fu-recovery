# AERA Wi-Fi startup for tb323fu (Lenovo Legion Y700 2025, SM8850/canoe).
# Structure follows the official AERA qcom trees (froggerpro / dada):
#   1. point firmware_class at the real modem image dir (no firmware copies)
#   2. hand the firmware filesystem to the WLAN driver via fs_ready
#   3. wait for wlan0, then start wpa_supplicant as AID_WIFI
# Kernel-matched WLAN modules are staged from vendor_dlkm by the AERA loader.

on init
    setprop wifi.driver.ready false

on property:twrp.modules.loaded=true
    setprop sys.aera.wlan.up 0
    setprop wifi.driver.ready false

    # request_firmware() must resolve to the real modem firmware image.
    # /vendor/firmware_mnt is a real bind mount of the modem vfat partition.
    write /sys/module/firmware_class/parameters/path /vendor/firmware_mnt/image

    # Integrated WCN7750 path (icnss2). Harmless if this platform lacks it.
    chmod 0222 /sys/bus/platform/drivers/icnss2/17010040.qcom,wcn7750/fs_ready
    write /sys/bus/platform/drivers/icnss2/17010040.qcom,wcn7750/fs_ready 1
    start aera-wlan-ready

# Retry discovery without resetting an already running WPSS or supplicant.
on property:post.decrypt.modules=true
    setprop sys.aera.wlan.up 0
    chmod 0222 /sys/bus/platform/drivers/icnss2/17010040.qcom,wcn7750/fs_ready
    write /sys/bus/platform/drivers/icnss2/17010040.qcom,wcn7750/fs_ready 1
    start aera-wlan-ready

on property:wifi.driver.ready=true
    # Android wpa_supplicant drops to AID_WIFI before opening this directory.
    mkdir /tmp/recovery 0770 root wifi
    mkdir /tmp/recovery/sockets 0770 wifi wifi
    start wpa_supplicant

on property:sys.aera.wlan.up=1 && property:wifi.driver.ready=true
    setprop sys.aera.wlan.up 0
    mkdir /tmp/recovery 0770 root wifi
    mkdir /tmp/recovery/sockets 0770 wifi wifi
    start wpa_supplicant

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    user root
    group root inet net_admin net_raw
    seclabel u:r:recovery:s0

service aera-wlan-ready /system/bin/sh -c "echo 'AERA Wi-Fi: waiting for wlan0' > /dev/kmsg; n=0; until test -e /sys/class/net/wlan0; do if test $$n -ge 60; then echo 'AERA Wi-Fi: wlan0 missing after 60 seconds' > /dev/kmsg; exit 1; fi; sleep 1; n=$$((n + 1)); done; echo 'AERA Wi-Fi: wlan0 ready' > /dev/kmsg; setprop wifi.driver.ready true"
    disabled
    oneshot
    timeout_period 60
    user root
    group root
    seclabel u:r:recovery:s0
