# AERA Wi-Fi bring-up for Lenovo TB323FU (QCA Peach / WCN7750)
#
# This group is never started at boot.  It is started only by an explicit
# property:
#
#   setprop sys.aera.wifi.load 1
#
# aera-load-group.sh loads cfg80211 + qca_cld3_peach_v2 and their real
# modules.dep dependency graph from /vendor_dlkm and /system_dlkm.  Then the
# cnss driver probe is released with fs_ready=1 and wpa_supplicant starts.

service aera-wifi-modules /system/bin/sh /system/bin/aera-load-group.sh wifi
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

on property:sys.aera.wifi.load=1
    setprop sys.aera.wifi.load 0
    start aera-wifi-modules

on property:aera.wifi.loaded=true
    start cnss-daemon
    wait /sys/bus/platform/drivers/cnss2/b0000000.qcom,cnss-peach/fs_ready 5
    chmod 222 /sys/bus/platform/drivers/cnss2/b0000000.qcom,cnss-peach/fs_ready
    write /sys/bus/platform/drivers/cnss2/b0000000.qcom,cnss-peach/fs_ready 1
    start aera-wlan-ready

on property:wifi.driver.ready=true
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0777 root root
    start wpa_supplicant

service wpa_supplicant /vendor/bin/hw/wpa_supplicant -Dnl80211 -iwlan0 -dd -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    user root
    group root wifi inet
    disabled
    seclabel u:r:recovery:s0

service cnss-daemon /vendor/bin/cnss-daemon -n -l
    user root
    group root wifi inet
    disabled
    seclabel u:r:recovery:s0

service aera-wlan-ready /system/bin/sh /system/bin/aera-wlan-ready.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
