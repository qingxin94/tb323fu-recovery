# Boot group: touch + the minimum SPU/weaver transport.
#
# Only top-level modules are listed.  aera-load-group.sh reads the real
# modules.dep and loads the dependency chain first.  Nothing from Wi-Fi,
# audio or haptics is in this group.

nvt_36xxx.ko
spss_utils.ko
spcom.ko

# Optional crypto/SPU helpers.  Missing or built-in modules are logged and
# skipped; they never block the recovery UI.
qce50_dlkm.ko
qcrypto-msm_dlkm.ko
qrng_dlkm.ko
smcinvoke_dlkm.ko
tz_log_dlkm.ko
tmecom-intf_dlkm.ko
