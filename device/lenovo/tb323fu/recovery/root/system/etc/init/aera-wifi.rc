# WiFi group: on-demand only.
# All binaries, firmware and configs stay on the real /vendor partition.

service vendor.wifi_hal_legacy /vendor/bin/hw/android.hardware.wifi-service
    interface aidl android.hardware.wifi.IWifi/default
    class hal
    capabilities NET_ADMIN NET_RAW SYS_MODULE
    user wifi
    group wifi gps
    disabled

service vendor.cnss-daemon /vendor/bin/cnss-daemon -n -l
    class core
    user root
    group wifi inet
    disabled

service wpa_supplicant /vendor/bin/hw/wpa_supplicant -Dnl80211 -iwlan0 -c/vendor/etc/wifi/wpa_supplicant.conf -O/tmp/recovery/sockets
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    user root
    group wifi inet
    disabled
    oneshot

service wifi_qos_daemon /vendor/bin/wifi_qos_daemon
    class late_start
    user wifi
    group wifi inet net_admin oem_2912 system
    capabilities NET_ADMIN
    disabled
    oneshot
