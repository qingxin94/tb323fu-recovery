# keystore2 in recovery — 覆盖 AERA 源码同名 rc
#
# 依据：成品基线 ISR 的 /system/etc/init/keystore2.rc
#   task_profiles ProcessCapacityHigh
#   rlimit memlock unlimited unlimited
#   critical window=0
#
# 取舍说明：
#   * task_profiles / rlimit memlock 取回。keystore 的密钥材料需要 mlock，
#     Android 默认 memlock 上限 65536 字节，对 keymint 会话偏小。
#   * critical window=0 【不采纳】。该指令语义是崩溃累计到阈值后重启进 bootloader；
#     recovery 下 keystore2 若陷入崩溃循环会直接掉 fastboot（v45 已踩过），
#     故保留系统默认的非 critical 行为，只做资源与调度对齐。

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    task_profiles ProcessCapacityHigh
    rlimit memlock unlimited unlimited
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0
