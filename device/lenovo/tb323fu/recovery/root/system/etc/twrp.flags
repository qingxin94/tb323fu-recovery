# AERA / TWRP partition flags — Lenovo Legion Y700 5th Gen (TB323FU)
# 分区名取自原厂 GPT（LUN0/LUN4/LUN5），A/B 设备，一律用 slotselect

# 动态分区（在 super 内）
/system         ext4    system                                        flags=display="System";slotselect;backup=1
/system_ext     ext4    system_ext                                    flags=display="System Ext";slotselect;backup=1
/product        ext4    product                                       flags=display="Product";slotselect;backup=1
/vendor         ext4    vendor                                        flags=display="Vendor";slotselect;backup=1
/vendor_dlkm    ext4    vendor_dlkm                                   flags=display="Vendor DLKM";slotselect;backup=1
/system_dlkm    ext4    system_dlkm                                   flags=display="System DLKM";slotselect;backup=1
/odm            ext4    odm                                           flags=display="ODM";slotselect;backup=1;nofail

# 数据 / 元数据
/metadata       f2fs    /dev/block/bootdevice/by-name/metadata         flags=display="Metadata";backup=1;flashimg=1
/data           f2fs    /dev/block/bootdevice/by-name/userdata         flags=display="Data";backup=1;flashimg=1

# 启动相关
/boot           emmc    /dev/block/bootdevice/by-name/boot             flags=slotselect;display="Boot";backup=1;flashimg=1
/init_boot      emmc    /dev/block/bootdevice/by-name/init_boot        flags=slotselect;display="Init Boot";backup=1;flashimg=1
/vendor_boot    emmc    /dev/block/bootdevice/by-name/vendor_boot      flags=slotselect;display="Vendor Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/bootdevice/by-name/recovery         flags=slotselect;display="Recovery";backup=1;flashimg=1
/dtbo           emmc    /dev/block/bootdevice/by-name/dtbo             flags=slotselect;display="DTBO";backup=1;flashimg=1
/efisp          emmc    /dev/block/bootdevice/by-name/efisp            flags=display="EFISP";backup=1;flashimg=1

# AVB
/vbmeta         emmc    /dev/block/bootdevice/by-name/vbmeta           flags=slotselect;display="VBMeta";backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/bootdevice/by-name/vbmeta_system    flags=slotselect;display="VBMeta System";backup=1;flashimg=1

# 固件 / 持久化
/firmware       vfat    /dev/block/bootdevice/by-name/modem            flags=slotselect;display="Firmware";fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"
/persist        ext4    /dev/block/bootdevice/by-name/persist          flags=display="Persist";backup=1;flashimg=1
/persist_image  emmc    /dev/block/bootdevice/by-name/persist          flags=display="Persist (raw)";backup=1

# Modem 子分区
/modem          emmc    /dev/block/bootdevice/by-name/modem            flags=slotselect;backup=1;display="Modem"
/bluetooth      emmc    /dev/block/bootdevice/by-name/bluetooth        flags=slotselect;backup=1;subpartitionof=/modem
/dsp            emmc    /dev/block/bootdevice/by-name/dsp              flags=slotselect;backup=1;subpartitionof=/modem
/fsg            emmc    /dev/block/bootdevice/by-name/fsg              flags=backup=1;display="FSG"
/soccp          emmc    /dev/block/bootdevice/by-name/soccp           flags=slotselect;backup=1;display="SOCCP"
