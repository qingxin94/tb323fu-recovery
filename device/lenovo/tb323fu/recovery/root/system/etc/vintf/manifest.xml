<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <version>1</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>4</version>
        <fqname>IKeyMintDevice/default</fqname>
        <fqname>IKeyMintDevice/strongbox</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>3</version>
        <fqname>IRemotelyProvisionedComponent/default</fqname>
        <fqname>IRemotelyProvisionedComponent/strongbox</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.secretkeeper</name>
        <version>2</version>
        <fqname>ISecretkeeper/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.weaver</name>
        <version>2</version>
        <fqname>IWeaver/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.spu</name>
        <version>2</version>
        <fqname>ISPUManager/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.graphics.allocator</name>
        <version>2</version>
        <fqname>IAllocator/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.boot</name>
        <fqname>IBootControl/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.secureclock</name>
        <version>1</version>
        <fqname>ISecureClock/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.sharedsecret</name>
        <version>1</version>
        <fqname>ISharedSecret/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.vibrator</name>
        <version>2</version>
        <fqname>IVibrator/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.lenovo.hardware.vibrator_dual</name>
        <fqname>IVibratorDual/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.wifi.supplicant</name>
        <version>4</version>
        <fqname>ISupplicant/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.wifi.supplicant</name>
        <version>1</version>
        <fqname>ISupplicantVendor/default</fqname>
    </hal>
</manifest>
