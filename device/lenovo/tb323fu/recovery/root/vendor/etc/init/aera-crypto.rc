# AERA crypto / gatekeeper services for TB323FU.
#
# These binaries and their ABI-matched libraries live in the recovery
# ramdisk overlay (/vendor), so they can start before the real vendor
# partition is mapped. SELinux runs recovery permissively, but keep an
# explicit recovery label so init performs the stock executable transition.

service vendor.qseecomd /vendor/bin/qseecomd
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
    socket notify-topology stream 660 system drmrpc
    class core
    disabled
    user root
    group root drmrpc
    seclabel u:r:recovery:s0

service vendor.gatekeeper_default /vendor/bin/hw/android.hardware.gatekeeper-rust-service-qti
    class early_hal
    disabled
    user system
    group system
    seclabel u:r:recovery:s0

service vendor.keymint /vendor/bin/hw/android.hardware.security.onekeymint-service-qti
    class early_hal
    disabled
    user system
    group system drmrpc
    seclabel u:r:recovery:s0
#
