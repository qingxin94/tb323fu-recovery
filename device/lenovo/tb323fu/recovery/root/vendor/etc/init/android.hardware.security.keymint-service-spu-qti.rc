# SPU KeyMint. Started when the SPU keymaster firmware loads.
# Aligned to proven TWRP baseline ISR.

service vendor.keymint-spu-qti /vendor/bin/hw/android.hardware.security.keymint-service-spu-qti
    class early_hal
    user system
    group system drmrpc
    disabled
    seclabel u:r:recovery:s0

on property:vendor.spcom.load.sp_keymaster=1
    start vendor.keymint-spu-qti
