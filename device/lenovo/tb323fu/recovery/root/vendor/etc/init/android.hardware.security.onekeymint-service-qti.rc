service vendor.keymint /vendor/bin/hw/android.hardware.security.onekeymint-service-qti
    class early_hal
    user system
    group system drmrpc
# Started by init.recovery.qcom.rc on crypto.ready=1, after prepdecrypt
# has mounted the installed vendor runtime and the security world is up.
