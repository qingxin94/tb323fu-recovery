# SPU Weaver. Enabled on the canoe SKU alongside the SPU gatekeeper.
# Aligned to proven TWRP baseline ISR.

on init && property:ro.boot.product.vendor.sku=canoe
    enable vendor.spu_weaver

service vendor.spu_weaver /vendor/bin/hw/android.hardware.weaver-service-spu-qti
    disabled
    class early_hal
    user system
    group system drmrpc
    seclabel u:r:recovery:s0
