# HLOS mink daemon. Started explicitly from the modules.loaded chain.
# Aligned to proven TWRP baseline ISR (single hlos_mink_opener socket, system group).

service vendor.minkdaemon /vendor/bin/hlosminkdaemon
    class late_start
    user system
    group system
    socket hlos_mink_opener stream 0660 system system
    disabled
    seclabel u:r:recovery:s0
