# Qualcomm secure execution environment daemon.
# Aligned to proven TWRP baseline ISR: disabled, started explicitly from the chain.

service vendor.qseecomd /vendor/bin/qseecomd
    socket notify-topology stream 660 system drmrpc
    class core
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0
