service battery_aidl_service /vendor/bin/hw/vendor.lenovo.hardware.battery-service
    class hal
    user root
    group root

# BEGIN Lenovo, zhilx1, 2025/12/16, BALDUR-7436, power-off charging led color.
# The healthd service not write the node directly, so we need use prop to write.
# 0: none; 13: red 14: blue; 12: green
on charger
    setprop vendor.lenovo.battery.charge_only_mode 1

on property:vendor.lenovo.battery.charge_only_mode=1 && property:vendor.lenovo.battery.charge_only_led_color=*
    write /sys/class/leds/aw22xxx_led/effect ${vendor.lenovo.battery.charge_only_led_color}
    write /sys/class/leds/aw22xxx_led/cfg 1
# END BALDUR-7436