# TB323FU recovery properties

ro.charger.enable_suspend=true

# SPU-backed Gatekeeper is the stock security level on this device.
vendor.gatekeeper.is_security_level_spu=1

# FBE metadata / dm-default-key uses the wrapped-key v2 format.
ro.crypto.dm_default_key.options_format.version=2

# Legacy Keymaster 4.x compatibility helper path.
keymaster_ver=4.x

persist.sys.fuse.passthrough.enable=true
